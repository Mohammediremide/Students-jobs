DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=3000
MAX_JOBS=60

# Brevo email (required for password reset codes)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=verified-sender@yourdomain.com
BREVO_SENDER_NAME=Students Jobs

# Password reset code settings
RESET_CODE_TTL_MINUTES=10
RESET_CODE_COOLDOWN_SECONDS=60
RESET_CODE_MAX_PER_HOUR=5
